<UserControl x:Class="DiskLens.BrowseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskLens">
 <UserControl.Resources>
  <local:RelativeSizeConverter x:Key="RelativeSize"/>
  <Style x:Key="BrowseLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="12,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="BrowseNumber" TargetType="TextBlock" BasedOn="{StaticResource BrowseLabel}"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
  <Style x:Key="BrowseHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="BrowseCell" TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border x:Name="CellSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CellSurface" Property="BorderBrush" Value="{DynamicResource BrowseBar}"/><Setter TargetName="CellSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="BrowseRow" TargetType="DataGridRow"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border x:Name="RowSurface" Background="{TemplateBinding Background}" CornerRadius="4"><DataGridCellsPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource BrowseHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource BrowseSelection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="MinHeight" Value="46"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrowseHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrowseSelection}"/></Trigger><DataTrigger Binding="{Binding DataContext.BrowseDensity,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"><Setter Property="MinHeight" Value="32"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <DockPanel Margin="8">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="↑ Parent folder" Command="{Binding Up}"/><TextBlock Grid.Column="1" Text="{Binding MapFolder}" ToolTip="{Binding MapFolder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid>
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="View" VerticalAlignment="Center"/><ComboBox x:Name="ViewPicker" ItemsSource="{Binding BrowseViews}" SelectedItem="{Binding BrowseView}" Width="130"/><TextBlock Text="Density" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding BrowseDensities}" SelectedItem="{Binding BrowseDensity}" Width="105"/><Button Content="Open selected" Command="{Binding Drill}" CommandParameter="{Binding SelectedMapEntry}" ToolTip="Browse the selected folder inside DiskLens"/><Button x:Name="OpenBrowseFolderButton" Content="Open folder" Command="{Binding OpenMapFolder}" ToolTip="Open the selected folder in Windows Explorer; for a file, open its containing folder and select it"/></WrapPanel>
  <TextBlock DockPanel.Dock="Top" Text="Largest indexed items · Logical size · Other indexed items groups the remainder" TextWrapping="Wrap" Margin="3,0,3,10"/>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedMapEntry.Path}" ToolTip="{Binding SelectedMapEntry.Path}" TextTrimming="CharacterEllipsis" Margin="3,8,3,3"/>
  <Grid>
   <DataGrid x:Name="BrowseGrid" ItemsSource="{Binding MapRows}" SelectedItem="{Binding SelectedMapEntry,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" RowBackground="{DynamicResource Bg}" AlternatingRowBackground="{DynamicResource Bg}" BorderThickness="0" FontSize="14" CellStyle="{StaticResource BrowseCell}" ColumnHeaderStyle="{StaticResource BrowseHeader}" EnableRowVirtualization="True" SelectionMode="Single" RowStyle="{StaticResource BrowseRow}" MouseDoubleClick="Rows_DoubleClick" PreviewKeyDown="Rows_KeyDown" CanUserAddRows="False">
    <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Style.Triggers><DataTrigger Binding="{Binding BrowseView}" Value="Space map"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" ElementStyle="{StaticResource BrowseLabel}" Width="2*" MinWidth="140" MaxWidth="360"/>
     <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" ElementStyle="{StaticResource BrowseNumber}" Width="110"/>
     <DataGridTemplateColumn Header="Relative size" Width="*" MinWidth="100" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Height="8" VerticalAlignment="Center" Margin="12,0" Maximum="100" Foreground="{DynamicResource BrowseBar}" Background="Transparent" BorderThickness="0"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="Transparent"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/></Grid></ControlTemplate></ProgressBar.Template><ProgressBar.Value><MultiBinding Mode="OneWay" Converter="{StaticResource RelativeSize}"><Binding Path="Size"/><Binding Path="DataContext.MapRows" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="DataContext.MapRows.Count" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></ProgressBar.Value></ProgressBar></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn x:Name="KindColumn" Header="Type" Binding="{Binding Kind}" ElementStyle="{StaticResource BrowseLabel}" Width="85"/>
    </DataGrid.Columns>
   </DataGrid>
   <local:Treemap Items="{Binding MapRows}" Drill="{Binding Drill}" SelectedEntry="{Binding SelectedMapEntry,Mode=TwoWay}"><local:Treemap.Style><Style TargetType="local:Treemap"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BrowseView}" Value="Space map"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:Treemap.Style></local:Treemap>
   <TextBlock Text="Scan a location to explore disk usage" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding MapRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
 </DockPanel>
</UserControl>
