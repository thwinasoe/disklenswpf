<UserControl x:Class="DiskLens.InvestigationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskLens" SizeChanged="LayoutChanged">
<Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="CompactRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<ComboBox x:Name="CompactNavigation" Grid.ColumnSpan="2" ItemsSource="{Binding InvestigationPresets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedInvestigation}" Visibility="Collapsed"/>
<StackPanel x:Name="Navigation" Grid.Row="1" Margin="5,12,12,5"><TextBlock Text="INVESTIGATE" Foreground="#83939C" FontSize="11"/><TextBlock Text="Find the space you can explain" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,10"/><TextBlock Text="Start with a practical question." TextWrapping="Wrap" Foreground="#83939C"/><ListBox ItemsSource="{Binding InvestigationPresets}" SelectedItem="{Binding SelectedInvestigation}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" Margin="0,15,0,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><local:AppIcon Kind="{Binding Icon}" Foreground="#37C6B5" Margin="0,0,10,0"/><TextBlock Text="{Binding Label}" Margin="0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
<DockPanel Grid.Column="1" Grid.Row="1" Margin="8"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding SelectedInvestigation.Label}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Description" Text="{Binding InvestigationDescription}" TextWrapping="Wrap" Foreground="#83939C"/><TextBlock Text="{Binding ComparisonContext}" TextWrapping="Wrap" Foreground="#83939C"/><WrapPanel><TextBox Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" Width="210" ToolTip="Path/name filter; wildcards and semicolon-separated patterns"/><Button Content="Refresh results" Command="{Binding RefreshInvestigation}"/><Button Content="Run health check" Command="{Binding CheckInvestigation}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedInvestigation.Id}" Value="health"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><WrapPanel><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedInvestigation.Id}" Value="duplicates"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button x:Name="QuickCheckButton" Content="Quick check" Command="{Binding QuickDuplicateCheck}" ToolTip="Fully verify up to 5,000 filtered candidates with SHA-256"/><Button x:Name="FullCheckButton" Content="Full check" Command="{Binding FullDuplicateCheck}" ToolTip="Fully verify every filtered candidate with SHA-256"/></WrapPanel></WrapPanel><Expander Header="Size, age and duplicate filters" Foreground="{DynamicResource Text}"><WrapPanel><TextBlock Text="Minimum bytes"/><TextBox Text="{Binding Minimum}" Width="95"/><TextBlock Text="Maximum (0 = any)"/><TextBox Text="{Binding Maximum}" Width="95"/><TextBlock Text="Duplicate category"/><ComboBox ItemsSource="{Binding DuplicateCategories}" SelectedItem="{Binding DuplicateCategory}" Width="130"/><CheckBox Content="Installer duplicates only" IsChecked="{Binding InstallerOnly}" Foreground="{DynamicResource Text}" Margin="5"/><TextBlock Text="Duplicate age (days)"/><TextBox Text="{Binding AgeDays}" Width="55"/></WrapPanel></Expander><TextBlock Text="{Binding InvestigationStatus}" TextWrapping="Wrap" Foreground="#37C6B5"/><ProgressBar x:Name="InvestigationProgress" Height="4" Margin="3,5,3,8" IsIndeterminate="{Binding IsInvestigationLoading}" Foreground="#37C6B5" Background="{DynamicResource Panel}" BorderThickness="0" AutomationProperties.Name="Loading investigation results"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsInvestigationLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><ScrollViewer x:Name="SummaryStrip" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding InvestigationCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="12" Margin="3" MinWidth="180"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#83939C"/><TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="240" FontSize="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Expander Header="Selected file details" Foreground="{DynamicResource Text}"><StackPanel><TextBlock Text="{Binding Selected.Path}" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.Detail}" TextWrapping="Wrap" MaxHeight="70"/></StackPanel></Expander><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><Button Content="Open folder" Command="{Binding Reveal}"/><Button Content="Recycle selected file…" Command="{Binding Recycle}"/><Button Content="Recycle selected files…" Command="{Binding BatchRecycle}"/><Button Content="Export displayed report" Command="{Binding Export}"/></StackPanel></ScrollViewer></StackPanel>
<DataGrid MouseDoubleClick="Files_DoubleClick" ItemsSource="{Binding InvestigationRows}" SelectedItem="{Binding Selected}" SelectionMode="Extended" SelectionChanged="FilesChanged"><DataGrid.Columns><DataGridTemplateColumn Header="Item" Width="2*" MinWidth="300"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4"><local:AppIcon Kind="{Binding IconName}" Foreground="#638DE1" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#83939C" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn MinWidth="75" Header="Change" Binding="{Binding Change}" Width="75"/><DataGridTextColumn MinWidth="90" Header="Difference" Binding="{Binding DifferenceText}" Width="90"/><DataGridTextColumn MinWidth="90" Header="Current size" Binding="{Binding SizeText}" Width="90"/><DataGridTextColumn Header="Explanation" Binding="{Binding Detail}" Width="2*" MinWidth="250"/></DataGrid.Columns></DataGrid>
</DockPanel></Grid></UserControl>




