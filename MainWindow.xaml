<Window x:Class="DiskLens.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskLens" Title="DiskLens • WPF" Icon="Assets/DiskLens.ico" Width="1200" Height="800" MinWidth="640" MinHeight="480" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
<Window.Resources><local:ButtonIconConverter x:Key="ButtonIconConverter"/><DataTemplate x:Key="IconLabel"><StackPanel Orientation="Horizontal"><local:AppIcon Kind="{Binding Converter={StaticResource ButtonIconConverter}}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Control}}" Margin="0,0,7,0"/><TextBlock Text="{Binding}" Margin="0" VerticalAlignment="Center"/></StackPanel></DataTemplate>
<SolidColorBrush x:Key="Bg" Color="#101416"/><SolidColorBrush x:Key="Panel" Color="#1D2327"/><SolidColorBrush x:Key="Text" Color="#EDF2F4"/><SolidColorBrush x:Key="Edge" Color="#37454D"/>
<Style TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonPressed}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#37C6B5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="ContentTemplate" Value="{StaticResource IconLabel}"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/></Style>
<Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="7"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/></Style>
<Style TargetType="TextBlock"><Setter Property="Margin" Value="3"/></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#192025"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
<Style TargetType="TabItem"><Setter Property="HeaderTemplate" Value="{StaticResource IconLabel}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="10,8" x:Name="TabBorder"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#37C6B5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="RowBackground" Value="{DynamicResource Panel}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Bg}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/></Style>
</Window.Resources>
<DockPanel Margin="12">
<StackPanel DockPanel.Dock="Top">
<DockPanel><StackPanel Orientation="Horizontal"><local:AppIcon Kind="Brand" Width="24" Height="24" Foreground="#37C6B5" Margin="3,0,7,0"/><TextBlock Text="DiskLens" FontSize="24" Foreground="#37C6B5" FontWeight="SemiBold"/></StackPanel><Button Content="Light / dark" Click="Theme_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Root,UpdateSourceTrigger=PropertyChanged}" ToolTip="Scan root"/><Button Grid.Column="1" Content="Browse" Command="{Binding Browse}"/><Button Grid.Column="2" Content="Scan" Command="{Binding Scan}"/><Button Grid.Column="3" Content="Stop" Command="{Binding Stop}" Foreground="#EF6B75"/></Grid>
<TextBlock Text="{Binding Context}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="60" Foreground="#37C6B5"/>
<ProgressBar Height="3" IsIndeterminate="{Binding Indeterminate}" Value="{Binding ProgressValue,Mode=OneWay}" Margin="3,5"/>
</StackPanel>
<TabControl SelectedIndex="{Binding ActiveTab}">
<TabItem Header="Map"><local:BrowseView/></TabItem>
<TabItem Header="Search"><DockPanel>
<StackPanel DockPanel.Dock="Top"><WrapPanel><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="160" Margin="3"/><TextBox Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" Width="220" KeyDown="SearchQuery_KeyDown" ToolTip="Name/path, wildcards or semicolon-separated patterns; press Enter to search"/><Button Content="Search" Command="{Binding Search}"/><Button Content="Duplicates" Command="{Binding Duplicate}"/><Button Content="Windows storage health" Command="{Binding Health}"/><Button Content="What changed" Command="{Binding Compare}"/></WrapPanel><Expander Header="Size, age and duplicate filters" Foreground="{DynamicResource Text}"><WrapPanel><TextBlock Text="Min bytes" VerticalAlignment="Center"/><TextBox Text="{Binding Minimum}" Width="95"/><TextBlock Text="Max bytes (0 = any)" VerticalAlignment="Center"/><TextBox Text="{Binding Maximum}" Width="95"/><CheckBox Content="Installer duplicates only" IsChecked="{Binding InstallerOnly}" Foreground="{DynamicResource Text}" Margin="5"/><TextBlock Text="Older than days"/><TextBox Text="{Binding AgeDays}" Width="55"/><Button Content="Previous" Command="{Binding Previous}"/><Button Content="Next" Command="{Binding Next}"/></WrapPanel></Expander></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Expander Header="Selected file details" Foreground="{DynamicResource Text}"><StackPanel><TextBlock Text="{Binding Selected.Path}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Selected.Detail}" TextWrapping="Wrap" MaxHeight="100"/></StackPanel></Expander><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><Button Content="Open folder" Command="{Binding Reveal}"/><Button Content="Recycle selected file…" Command="{Binding Recycle}"/><Button Content="Recycle selected files…" Command="{Binding BatchRecycle}"/><Button Content="Export displayed report" Command="{Binding Export}"/><Button Content="Export complete index" Command="{Binding ExportAll}"/></StackPanel></ScrollViewer></StackPanel>
<ProgressBar DockPanel.Dock="Top" Height="4" Margin="3,5" IsIndeterminate="{Binding IsSearchLoading}" Foreground="#37C6B5"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSearchLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><DataGrid MouseDoubleClick="Files_DoubleClick" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Extended" SelectionChanged="Files_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" MinWidth="120"/><DataGridTextColumn Header="Explanation" Binding="{Binding Detail}" Width="2*" MinWidth="180"/></DataGrid.Columns></DataGrid>
</DockPanel></TabItem>
<TabItem Header="Investigate"><local:InvestigationView/></TabItem>
<TabItem Header="Insights / History"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<WrapPanel><TextBlock Text="Storage history" FontSize="18" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="110"/><Button Content="File type details" Command="{Binding Types}"/></WrapPanel>
<TextBlock Text="{Binding InsightsStatus}" TextWrapping="Wrap"/>
<local:HistoryChart Height="210" Points="{Binding History}" Root="{Binding SelectedScan.Root}" Period="{Binding Period}"/>
<WrapPanel><Border Background="{DynamicResource Panel}" Padding="12" Margin="3"><StackPanel Width="470"><TextBlock Text="Storage by category" FontSize="17" FontWeight="SemiBold"/><local:BreakdownChart Height="220" Items="{Binding InsightCategories}"/></StackPanel></Border><Border Background="{DynamicResource Panel}" Padding="12" Margin="3"><StackPanel Width="470"><TextBlock Text="Largest folders and root files" FontSize="17" FontWeight="SemiBold"/><local:BreakdownChart Height="220" Items="{Binding InsightFolders}"/></StackPanel></Border></WrapPanel>
<TextBlock Text="Completed scan history • select a snapshot to use it in every view" FontWeight="SemiBold"/>
<DataGrid Height="200" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedScan}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Location" Binding="{Binding Root}" Width="*"/><DataGridTextColumn Header="Scan UTC" Binding="{Binding Date}" Width="230"/><DataGridTextColumn Header="Files" Binding="{Binding Files}"/><DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}"/><DataGridCheckBoxColumn Header="Safe" Binding="{Binding Safe}"/><DataGridTextColumn Header="Skipped paths" Binding="{Binding Issues}"/></DataGrid.Columns></DataGrid>
</StackPanel></ScrollViewer></TabItem><TabItem Header="Drives"><DockPanel><Button DockPanel.Dock="Top" Content="Refresh connected and remembered drives" Command="{Binding RefreshDrives}"/><ListBox ItemsSource="{Binding Drives}" Background="{DynamicResource Bg}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Panel}" Padding="12" Margin="4"><WrapPanel><TextBlock Text="{Binding Path}" VerticalAlignment="Center" Margin="3,0,12,0" Width="100" Foreground="{DynamicResource Text}"/><TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" Margin="3,0,12,0" Width="100" Foreground="{DynamicResource Text}"/><TextBlock Text="{Binding Detail}" VerticalAlignment="Center" Margin="3,0,24,0" Foreground="{DynamicResource Text}"/><Button Content="View last scan" Command="{Binding DataContext.ViewDrive,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Scan / Rescan" Command="{Binding DataContext.ScanDrive,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></WrapPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
<TabItem Header="Settings"><ScrollViewer><StackPanel Margin="15"><CheckBox Content="Safe scan mode (automatically enabled for removable drives)" IsChecked="{Binding Safe}" Foreground="{DynamicResource Text}" Margin="3,12"/><TextBlock Text="Scan exclusions: path text or wildcard patterns separated by semicolons"/><TextBox Text="{Binding Exclusions,UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Snapshots retained per location (1–365). Old DiskLens snapshots only are removed."/><TextBox Text="{Binding Retention}" Width="100" HorizontalAlignment="Left"/><TextBlock Text="Default minimum duplicate file size (bytes)"/><TextBox Text="{Binding DuplicateMinimum}" Width="120" HorizontalAlignment="Left"/><TextBlock Text="Scan reminders while this app is open"/><ComboBox ItemsSource="{Binding ReminderModes}" SelectedItem="{Binding Reminder}" Width="140" HorizontalAlignment="Left"/><Button Content="Forget selected location data…" Command="{Binding Forget}" HorizontalAlignment="Left"/><TextBlock Text="No AI or local models. Reparse points are skipped. Allocated disk size can differ from logical file bytes.&#10;Storage issues records inaccessible and timed-out paths; this is not a physical-drive health guarantee.&#10;Cleanup protects Windows and Program Files and always uses native Recycle Bin confirmation." TextWrapping="Wrap" Margin="3,20"/></StackPanel></ScrollViewer></TabItem>
</TabControl>
</DockPanel>
</Window>










